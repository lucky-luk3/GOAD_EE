[all:vars]
; domain_name : folder inside ad/
domain_name=REDIL
; administrator user
admin_user=administrator

;use to setup a dns server in the start of provisioning
force_dns_server=no
dns_server=x.x.x.x

;dns server forwarder
dns_server_forwarder=1.1.1.1

; winrm connection (windows)
ansible_user=vagrant
ansible_password=vagrant
ansible_connection=winrm
ansible_winrm_server_cert_validation=ignore
ansible_winrm_operation_timeout_sec=400
ansible_winrm_read_timeout_sec=500

; proxy settings (the lab need internet for some install, if you are behind a proxy you should set the proxy here)
enable_http_proxy=no
ad_http_proxy=http://x.x.x.x:xxxx
ad_https_proxy=http://x.x.x.x:xxxx

; LAB SCENARIO CONFIGURATION -----------------------------

; computers inside domain (mandatory)
[domain]
dc01

[linux_domain]

; domain controller (mandatory)
[dc]
dc01

; domain server to enroll (none, single DC)
[server]

; workstation to enroll (none)
[workstation]

; parent domain controller (mandatory)
[parent_dc]
dc01

; child domain controller (none)
[child_dc]

; external trust (none)
[trust]

; install adcs (Enterprise CA on the DC) -> needed for the ESC4 chain
[adcs]
dc01

; NOTE: we intentionally do NOT enrol the DC in [adcs_customtemplates].
; That role publishes GOAD's ESC1/ESC2/ESC9/ESC13 templates to "Domain Users",
; which would give EVERY domain user a path to Domain Admin. Instead the ESC4
; abuse is scoped to the "PKI Administrators" group via scripts/esc4.ps1.
[adcs_customtemplates]

; no iis / mssql / webdav in this minimal single-DC lab
[iis]
[mssql]
[mssql_ssms]
[webdav]

[laps_dc]
[laps_server]
[laps_workstation]

; allow computer update
[update]
dc01

; disable update
[no_update]

; defender
[defender_on]
[defender_off]
dc01

;stay empty until override
[extensions]
